# Copy to .env — do not commit secrets.

ENV=dev
LOG_LEVEL=info
API_PORT=:8080
API_TOKEN=

DB_SERVER=
DB_PORT=1433
DB_NAME=
DB_USER=svc_patient_api_ro
DB_PASSWORD=
DB_RW_USER=
DB_RW_PASSWORD=
DB_APP_NAME=medkvadrat-patient-api
DB_ENCRYPT=disable
DB_TRUST_SERVER_CERT=false

GATEWAY_DB_PATH=./gateway.db

MEDIALOG_WRITE_ENABLED=false
MEDIALOG_WRITE_ALLOW_PATIENTS=
MEDIALOG_WRITE_ALLOW_PL_SUBJ=
MOTCONSU_POLL_ENABLED=false
CORS_ALLOWED_ORIGINS=
# PL_EXAM_ID листа ожидания (SQL: NAME LIKE N'%ожидан%' OR id in this list). Default 3118.
WAITLIST_EXAM_IDS=3118

AUTH_MODE=dev
JWT_SECRET=
OTP_HMAC_SECRET=
